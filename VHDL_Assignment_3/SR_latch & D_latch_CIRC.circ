  <vhdl appearance="logisim_evolution" name="D_Latch">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.ALL;&#13;
&#13;
ENTITY D_Latch IS&#13;
PORT (&#13;
	en : IN std_logic;
	D   : IN std_logic;
	Q   : OUT std_logic
);&#13;
END D_Latch;&#13;
&#13;&#13;
ARCHITECTURE bhv OF D_Latch IS&#13;
&#13;BEGIN&#13;

	PROCESS(en,D)
	BEGIN
		IF (en = '1') THEN
			Q &lt;= D;

		END IF;
		
	END PROCESS;
END bhv;&#13;

</vhdl>
  <vhdl appearance="logisim_evolution" name="SR_latch">LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE ieee.numeric_std.ALL;

ENTITY SR_latch IS
PORT ( 
	S,R : IN    STD_LOGIC;
     Q   : OUT   STD_LOGIC
);
END SR_latch;

ARCHITECTURE bhv OF SR_latch IS
SIGNAL notQ : STD_LOGIC;
SIGNAL Q_temp : STD_LOGIC;
BEGIN

Q   &lt;= Q_temp;
Q_temp  &lt;= R nor notQ;
notQ &lt;= S nor Q_temp;
end bhv;

</vhdl>
