  <vhdl appearance="logisim_evolution" name="JK_FlipFlop">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.numeric_std.ALL;

ENTITY JK_FlipFlop IS
PORT (
	clr : IN std_logic;
	set : IN std_logic;
	clk : IN std_logic;
	J   : IN std_logic;
	K   : IN std_logic;
	Q   : OUT std_logic
);
END JK_FlipFlop;


ARCHITECTURE bhv OF JK_FlipFlop IS
SIGNAL Q_temp : std_logic := '0';

BEGIN
	Q &lt;= Q_temp;
	PROCESS(clk,clr,set)
	BEGIN
		IF clr = '1' THEN   -- CLEAR (RESET)
			Q_temp &lt;= '0';
		ELSIF set = '1' THEN   -- SET
			Q_temp &lt;= '1';
			
		ELSIF (clk'event AND clk = '1') THEN
			IF (J = '1' AND K = '0') THEN    -- SET
				Q_temp &lt;= '1';
			ELSIF (J = '0' AND K = '1') THEN -- RESET
				Q_temp &lt;= '0';
			ELSIF (J = '1' AND K = '1') THEN -- TOGLE
				Q_temp &lt;= NOT Q_temp;
					
			END IF;
		
	END PROCESS;
END ARCHITECTURE bhv;

</vhdl>
