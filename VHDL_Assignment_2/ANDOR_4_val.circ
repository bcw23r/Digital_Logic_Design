--entity

ENTITY val_4_and_or IS
	PORT (
		
a,b,c,d : IN std_logic;
		and_out, or_out : OUT std_logic
	);
END ENTITY val_4_and_or;


--arcitecture
ARCHITECTURE bhv OF val_4_and_or IS

BEGIN
	and_out &lt;= a and b and c and d;
	or_out &lt;= a or b or c or d;


END ARCHITECTURE bhv;


