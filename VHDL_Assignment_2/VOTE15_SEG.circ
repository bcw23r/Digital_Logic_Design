  <vhdl appearance="logisim_evolution" name="vote15_seg">LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity
ENTITY vote15_seg IS
	PORT (
        	vt  : IN  std_logic_vector(14 DOWNTO 0);  
        	en  : IN  std_logic;                   
       	seg : OUT std_logic_vector(6 DOWNTO 0)
     );
END ENTITY vote15_seg;

--architecture
ARCHITECTURE bhv OF vote15_seg IS
BEGIN
    PROCESS(vt, en)
        VARIABLE cnt : integer RANGE 0 TO 15;
    BEGIN
        cnt := 0;
        FOR i IN vt'RANGE LOOP
            IF vt(i) = '1' THEN
                cnt := cnt + 1;
            END IF;
        END LOOP;

        IF en = '0' THEN
            seg &lt;= "0000000";
        ELSE
            CASE cnt IS
                WHEN 0  =&gt; seg &lt;= "1111110"; -- 0
                WHEN 1  =&gt; seg &lt;= "0110000"; -- 1
                WHEN 2  =&gt; seg &lt;= "1101101"; -- 2
                WHEN 3  =&gt; seg &lt;= "1111001"; -- 3
                WHEN 4  =&gt; seg &lt;= "0110011"; -- 4
                WHEN 5  =&gt; seg &lt;= "1011011"; -- 5
                WHEN 6  =&gt; seg &lt;= "1011111"; -- 6
                WHEN 7  =&gt; seg &lt;= "1110000"; -- 7
                WHEN 8  =&gt; seg &lt;= "1111111"; -- 8
                WHEN 9  =&gt; seg &lt;= "1111011"; -- 9
                WHEN 10 =&gt; seg &lt;= "1110111"; -- A
           	 WHEN 11 =&gt; seg &lt;= "0011111"; -- b
                WHEN 12 =&gt; seg &lt;= "1001110"; -- C
                WHEN 13 =&gt; seg &lt;= "0111101"; -- d
                WHEN 14 =&gt; seg &lt;= "1001111"; -- E
                WHEN 15 =&gt; seg &lt;= "1000111"; -- F
                WHEN OTHERS =&gt; seg &lt;= "0000000";
            END CASE;
        END IF;
    END PROCESS;
    
END ARCHITECTURE bhv;

</vhdl>
